# Copialo a .env.local (local) y cargá los mismos en Vercel → Project → Settings → Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Server-only (Next, worker, scripts/*). Bypassa RLS. El navegador NO recibe
# ninguna key: habla con Supabase a través del gateway /api/db con su sesión.
SUPABASE_SERVICE_ROLE_KEY=
# Sólo fallback mientras no se corra supabase_migration_lock_anon.sql; después no sirve para nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM para análisis IA + AI Chat. Elegí UNO:
#  - OpenAI directo (ChatGPT): seteá OPENAI_API_KEY (usa gpt-5.4-mini)
#  - OpenRouter: seteá OPENROUTER_API_KEY (usa anthropic/claude-3.5-haiku)
# Si están ambas, gana OPENAI_API_KEY. Opcional: LLM_MODEL para forzar el modelo.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL=

# AI Chat: piso de vistas (= reach) para que un reel entre al dossier que lee la IA.
# Por debajo se considera fallido y NO se manda al modelo (menos tokens, más señal).
# Se sigue transcribiendo/analizando igual. Por defecto 800 si no se setea.
# CHAT_MIN_VIEWS=800

# Apify (obtiene el mp4 del reel para transcribir, importar videos y escanear referentes)
# Pool de keys: se usan en orden y, si una se queda sin crédito (el plan FREE corta
# en USD 5 por ciclo), src/lib/apify.ts reintenta con la siguiente. Se pueden
# sumar APIFY_API_TOKEN_3 … _9 con el mismo patrón.
APIFY_API_TOKEN=
APIFY_API_TOKEN_2=

# ElevenLabs (Speech-to-Text / Scribe)
ELEVENLABS_API_KEY=

# Acceso al dashboard (login). Los usuarios viven en la tabla app_users (migración
# supabase_migration_auth.sql): se administran desde /admin o con scripts/auth-cli.mjs.
# Sin la tabla o sin la service key la app se CIERRA (no queda abierta "por las dudas").
# AUTH_SECRET: string aleatorio largo (`openssl rand -hex 32`). Firma el header interno
# proxy → handlers para no consultar la sesión dos veces por request. Recomendado.
AUTH_SECRET=

# Meta Graph API (seguidores, métricas, audiencia, sincronización)
# Para publicar (trial reels / reels / historias) el token necesita el permiso
# instagram_business_content_publish y una cuenta profesional conectada a una Página.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Opcional: si lo definís, se usa en vez del ID por defecto del código.
META_IG_ACCOUNT_ID=

# Automatizaciones: mismo token de System User, con permisos de comentarios y mensajes.
META_PAGE_ID=1061609440358642
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_CALLBACK_URL=https://tony-dashboard-psi.vercel.app/api/webhooks/instagram
# Endpoint del envío: page (por defecto) o instagram si la prueba lo requiere.
META_MESSAGING_ENDPOINT=page
AUTOMATION_MAX_DM_PER_HOUR=180

# ── Crevy Studio (Historias + Variantes + Calendario) ───────────────────────
# Google Drive OAuth (importar fotos de fondo desde Drive).
# Redirect URI a registrar en Google Cloud Console → Credentials:
#   http://localhost:3000/api/google/callback  (+ la URL de Vercel en prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Worker del VPS (Contabo/Easypanel): genera variantes y publica.
# PUBLISH_DRY_RUN=1 -> el publicador loguea el payload pero NO publica en Instagram.
# Dejalo en 1 hasta validar todo el flujo end-to-end.
PUBLISH_DRY_RUN=1
# Intervalo de polling del worker en ms (por defecto 20000).
WORKER_POLL_MS=20000
