# Copialo a .env.local (local) y cargá los mismos en Vercel → Project → Settings → Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM para análisis IA + AI Chat. Elegí UNO:
#  - OpenAI directo (ChatGPT): seteá OPENAI_API_KEY (usa gpt-5.4-mini)
#  - OpenRouter: seteá OPENROUTER_API_KEY (usa anthropic/claude-3.5-haiku)
# Si están ambas, gana OPENAI_API_KEY. Opcional: LLM_MODEL para forzar el modelo.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL=

# AI Chat: piso de vistas (= reach) para que un reel entre al dossier que lee la IA.
# Por debajo se considera fallido y NO se manda al modelo (menos tokens, más señal).
# Se sigue transcribiendo/analizando igual. Por defecto 800 si no se setea.
# CHAT_MIN_VIEWS=800

# Apify (obtiene el mp4 del reel para transcribir)
APIFY_API_TOKEN=

# ElevenLabs (Speech-to-Text / Scribe)
ELEVENLABS_API_KEY=

# Acceso al dashboard (login). Solo en producción (Vercel); si no se setean, la app
# queda abierta (útil en local). Multi-usuario: separá usuarios con coma, cada uno email:clave.
#   AUTH_USERS="tony@email.com:clave1,companera@email.com:clave2"
# AUTH_SECRET = string aleatorio largo (firma las sesiones).
AUTH_USERS=
AUTH_SECRET=

# Meta Graph API (seguidores, métricas, audiencia, sincronización)
# Para publicar (trial reels / reels / historias) el token necesita el permiso
# instagram_business_content_publish y una cuenta profesional conectada a una Página.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Opcional: si lo definís, se usa en vez del ID por defecto del código.
META_IG_ACCOUNT_ID=

# ── Crevy Studio (Historias + Variantes + Calendario) ───────────────────────
# Google Drive OAuth (importar fotos de fondo desde Drive).
# Redirect URI a registrar en Google Cloud Console → Credentials:
#   http://localhost:3000/api/google/callback  (+ la URL de Vercel en prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Worker del VPS (Contabo/Easypanel): genera variantes y publica.
# PUBLISH_DRY_RUN=1 -> el publicador loguea el payload pero NO publica en Instagram.
# Dejalo en 1 hasta validar todo el flujo end-to-end.
PUBLISH_DRY_RUN=1
# Intervalo de polling del worker en ms (por defecto 20000).
WORKER_POLL_MS=20000
