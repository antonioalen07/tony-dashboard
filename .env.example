# Copialo a .env.local (local) y cargá los mismos en Vercel → Project → Settings → Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter (análisis IA + AI Chat, modelo anthropic/claude-3.5-haiku)
OPENROUTER_API_KEY=

# Apify (obtiene el mp4 del reel para transcribir)
APIFY_API_TOKEN=

# ElevenLabs (Speech-to-Text / Scribe)
ELEVENLABS_API_KEY=

# Meta Graph API (seguidores, métricas, audiencia, sincronización)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Opcional: si lo definís, se usa en vez del ID por defecto del código.
META_IG_ACCOUNT_ID=
